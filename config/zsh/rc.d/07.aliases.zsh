# -F (--classify) takes an optional value, so it must come before any path argument.
alias ll="eza -F --long --header --icons --group-directories-first --sort=ext"  # eza --long - long listing with icons, dirs grouped first, sorted by extension
alias lla="ll -aDf"  # eza -aDf - all entries incl. hidden (-D and -f cancel each other out)
alias lld="ll -D"  # eza -D - directories only
alias llda="lld -a"  # eza -a - directories only, incl. hidden
alias llf="ll -f"  # eza -f - files only
alias llfa="ll -af"  # eza -af - files only, incl. hidden
alias glogdp="git log --stat --patch --graph --pretty='\''%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'\''"  # git log - graph with stat+patch, colored hash, refs, date and author
alias y="xclip -selection clipboard"  # xclip - copy stdin to the X clipboard (echo hi | y)
alias p="xclip -selection clipboard -o"  # xclip - print the X clipboard contents
alias ranger='ranger --choosedir=$HOME/.rangerdir; LASTDIR=`cat $HOME/.rangerdir`; cd "$LASTDIR"'  # ranger - open ranger, cd to last visited dir on exit
alias v="nvim"  # nvim - open Neovim
alias cat="bat"  # bat - view files with bat (syntax highlighting, paging)
alias lg="lazygit"  # lazygit - open lazygit TUI
alias ld="lazydocker"  # lazydocker - open lazydocker TUI
# --- .NET ---
alias dn='dotnet new'  # dotnet new - create a project or item
alias dr='dotnet run'  # dotnet run - build and run
alias dt='dotnet test'  # dotnet test - run tests
alias dw='dotnet watch'  # dotnet watch - rebuild on changes
alias dwr='dotnet watch run'  # dotnet watch run
alias dwt='dotnet watch test'  # dotnet watch test
alias ds='dotnet sln'  # dotnet sln - manage solution files
alias da='dotnet add'  # dotnet add - add package or reference
alias dp='dotnet pack'  # dotnet pack - create a NuGet package
alias dng='dotnet nuget'  # dotnet nuget - NuGet tooling
alias db='dotnet build'  # dotnet build
alias dres='dotnet restore'  # dotnet restore
alias update='sudo pacman -Syu'  # pacman -Syu - full system upgrade
# --- GIT ---
alias gpu='git push upstream'  # git push - push commits to the upstream remote
alias grb='git rebase'  # git rebase - rebase the current branch
alias grba='git rebase --abort'  # git rebase --abort - abort an in-progress rebase
alias grbc='git rebase --continue'  # git rebase --continue - continue an in-progress rebase
alias grbi='git rebase --interactive'  # git rebase --interactive - interactively edit commits during a rebase
alias grbo='git rebase --onto'  # git rebase --onto - rebase a branch onto a different base
alias grbs='git rebase --skip'  # git rebase --skip - skip the current patch during a rebase
alias gstall='git stash --all'  # git stash --all - stash all changes, including untracked and ignored files
alias gstaa='git stash apply'  # git stash apply - apply the latest stash, keeping it in the list
alias gstd='git stash drop'  # git stash drop - drop the latest stash
alias gstl='git stash list'  # git stash list - list all stashes
alias gstp='git stash pop'  # git stash pop - apply the latest stash and remove it from the list
alias gsw='git switch'  # git switch - switch to another branch
alias gswc='git switch --create'  # git switch --create - create a new branch and switch to it
alias gstpi='git_stash_pick'  # git - interactively pick changed files to stash
alias gra='git restore --staged --worktree . && git clean -fd'  # git restore + clean - discard all changes and delete untracked files (destructive)
alias gcu='git reset HEAD~1'  # git reset - undo last commit, keep changes
# --- DOCKER (all aliases start with dc) ---
alias dcbl='docker build'  # docker build - build an image from a Dockerfile
alias dcin='docker container inspect'  # docker container inspect - show detailed information on containers
alias dcls='docker container ls'  # docker container ls - list running containers
alias dclsa='docker container ls -a'  # docker container ls -a - list running and stopped containers
alias dcprune='docker container prune'  # docker container prune - remove all stopped containers
alias dcib='docker image build'  # docker image build - build an image from a Dockerfile (same as docker build)
alias dcii='docker image inspect'  # docker image inspect - show detailed information on images
alias dcils='docker image ls'  # docker image ls - list images
alias dcipu='docker image push'  # docker image push - push an image to a registry
alias dcipru='docker image prune -a'  # docker image prune -a - remove all images not used by a container
alias dcirm='docker image rm'  # docker image rm - remove one or more images
alias dcit='docker image tag'  # docker image tag - tag an image with a name and tag
alias dclo='docker container logs'  # docker container logs - fetch the logs of a container
alias dcnc='docker network create'  # docker network create - create a network
alias dcncn='docker network connect'  # docker network connect - connect a container to a network
alias dcndcn='docker network disconnect'  # docker network disconnect - disconnect a container from a network
alias dcni='docker network inspect'  # docker network inspect - show detailed information on networks
alias dcnls='docker network ls'  # docker network ls - list networks
alias dcnprune='docker network prune'  # docker network prune - remove all unused networks
alias dcnrm='docker network rm'  # docker network rm - remove one or more networks
alias dcpo='docker container port'  # docker container port - list port mappings for a container
alias dcps='docker ps'  # docker ps - list running containers
alias dcpsa='docker ps -a'  # docker ps -a - list running and stopped containers
alias dcpu='docker pull'  # docker pull - pull an image from a registry
alias dcr='docker container run'  # docker container run - create and start a container
alias dcrit='docker container run -it'  # docker container run -it - create and start a container in an interactive shell
alias dcrm='docker container rm'  # docker container rm - remove one or more containers
alias 'dcrm!'='docker container rm -f'  # docker container rm -f - force-remove a running container (SIGKILL)
alias dcsprune='docker system prune'  # docker system prune - remove unused data
alias dcst='docker container start'  # docker container start - start one or more stopped containers
alias dcrs='docker container restart'  # docker container restart - restart one or more containers
alias dcsta='docker stop $(docker ps -q)'  # docker stop - stop all running containers
alias dcstp='docker container stop'  # docker container stop - stop one or more running containers
alias dcsts='docker stats'  # docker stats - live resource usage statistics for containers
alias dctop='docker top'  # docker top - list the running processes of a container
alias dcvi='docker volume inspect'  # docker volume inspect - show detailed information on volumes
alias dcvls='docker volume ls'  # docker volume ls - list volumes
alias dcvprune='docker volume prune'  # docker volume prune - remove unused volumes
alias dcxc='docker container exec'  # docker container exec - run a command in a running container
alias dcxcit='docker container exec -it'  # docker container exec -it - run a command in a running container interactively
